---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <div id="uploadScreen">
    <div style="position:absolute;top:14px;right:16px;z-index:20"><div class="theme-wrap"><button class="header-btn theme-btn" id="themeBtnUpload" title="Cambiar el tema de colores">🎨 Tema</button><div class="theme-menu"></div></div></div>
    <div class="upload-kicker">libro de gastos personal</div>
    <h1 class="upload-title">Mis Finanzas</h1>
    <p class="upload-sub">Subí tu Excel exportado <strong>(Gastos · Ingresos · Transferencias)</strong> y obtené tu análisis completo al instante. Todo se procesa en tu navegador, nada se sube a un servidor.</p>

    <div class="upload-box" id="uploadBox">
      <input type="file" id="fileInput" accept=".xlsx,.xls" />
      <div class="upload-icon">📂</div>
      <p><strong>Tocá o arrastrá tu archivo</strong><br />.xlsx con hojas Gastos / Ingresos / Transferencias</p>
    </div>

    <div id="savedFileBox"></div>
    <button class="demo-btn" id="demoBtn">▶ Usar datos de demo</button>

    <details class="cfg-box" style="margin-top:18px;max-width:720px;width:100%">
      <summary>⚙ Mi Excel tiene otro formato (mapeo de columnas)</summary>
      <div id="colmapForm"></div>
    </details>
    <div class="upload-spec">
      <span class="spec-chip">Fecha y hora</span>
      <span class="spec-chip">Categoría</span>
      <span class="spec-chip">Cuenta</span>
      <span class="spec-chip">Cantidad ARS</span>
      <span class="spec-chip">Comentario</span>
    </div>
  </div>

  <div id="app">
    <header class="app-header">
      <div class="logo">mis<span>finanzas</span></div>
      <div id="dateRangeLabel"></div>
      <div class="theme-wrap"><button class="header-btn theme-btn" id="themeBtn" title="Cambiar el tema de colores">🎨 Tema</button><div class="theme-menu"></div></div>
      <button class="header-btn" id="reportBtn" title="Informe imprimible del mes">🖨 Informe</button>
      <button class="header-btn" id="exportBtn" title="Descargar los datos filtrados">↓ CSV</button>
      <button class="header-btn" id="reloadBtn">↑ Nuevo archivo</button>
    </header>

    <div class="mobile-bar">
      <select class="filter-select" id="tabSelect" aria-label="Sección"></select>
      <button class="header-btn" id="filtersToggle">⚙ Filtros</button>
    </div>

    <div class="filters-bar" id="filtersBar">
      <span class="filter-label">AÑO</span>
      <select class="filter-select narrow" id="filterYear"><option value="all">Todos</option></select>
      <span class="filter-label">MES</span>
      <select class="filter-select narrow" id="filterMonth"><option value="all">Todos</option></select>
      <div class="sep"></div>
      <span class="filter-label">PERÍODO</span>
      <button class="filter-pill active" data-period="all">Todo</button>
      <button class="filter-pill" data-period="6">6 meses</button>
      <button class="filter-pill" data-period="3">3 meses</button>
      <div class="sep"></div>
      <span class="filter-label">CUENTA</span>
      <select class="filter-select" id="filterAccount"><option value="all">Todas</option></select>
      <span class="filter-label">CATEGORÍA</span>
      <select class="filter-select" id="filterCategory"><option value="all">Todas</option></select>
      <span class="filter-label">DESDE</span>
      <input class="filter-select" id="filterFrom" type="date" />
      <span class="filter-label">HASTA</span>
      <input class="filter-select" id="filterTo" type="date" />
      <span class="filter-label">BUSCAR</span>
      <input class="filter-select" id="filterText" type="search" placeholder="comentario, categoría…" />
      <span class="filter-label">MONTO MÍN.</span>
      <input class="filter-select narrow" id="filterMinAmount" type="number" placeholder="$0" min="0" step="1000" />
      <div class="sep"></div>
      <button class="exclude-toggle-btn" id="excludeToggle">⊘ Excluir categorías</button>
      <button class="reset-btn" id="resetFiltersBtn">✕ Limpiar</button>
    </div>

    <div class="exclude-panel" id="excludePanel"></div>

    <nav class="tab-nav">
      <button class="tab-btn active" data-tab="resumen">Resumen</button>
      <button class="tab-btn" data-tab="gastos">Gastos</button>
      <button class="tab-btn" data-tab="ingresos">Ingresos</button>
      <button class="tab-btn" data-tab="flujo">Flujo</button>
      <button class="tab-btn" data-tab="proyeccion">Proyección</button>
      <button class="tab-btn" data-tab="ahorros"> Ahorros<span class="stamp" id="alertCount" style="color:var(--red)">0</span></button>
      <button class="tab-btn" data-tab="presupuesto">Presupuesto</button>
      <button class="tab-btn" data-tab="metas">Metas</button>
      <button class="tab-btn" data-tab="analisis">Análisis</button>
      <button class="tab-btn" data-tab="patrimonio">Patrimonio</button>
      <button class="tab-btn" data-tab="habitos">Hábitos</button>
      <button class="tab-btn" data-tab="comentarios">Comentarios</button>
      <button class="tab-btn" data-tab="cuentas">Cuentas</button>
    </nav>

    <!-- ── RESUMEN ── -->
    <div class="page active" id="page-resumen">
      <div id="fileDiff"></div>
      <div class="kpi-grid" id="kpiResumen"></div>
      <div class="card card-mb">
        <h3>Ingresos vs Gastos</h3>
        <canvas id="chartResumen"></canvas>
      </div>
      <div class="grid-2">
        <div class="card"><h3>Balance acumulado</h3><canvas id="chartBalance"></canvas></div>
        <div class="card"><h3>Tasa de ahorro mensual</h3><canvas id="chartTasa"></canvas></div>
      </div>
      <div class="grid-2">
        <div class="card">
          <h3>Composición Ingresos</h3>
          <canvas id="chartIngDonut"></canvas>
        </div>
        <div class="card">
          <h3>Composición Gastos</h3>
          <canvas id="chartGasDonut"></canvas>
        </div>
      </div>
      <div class="card card-mb">
        <h3>Heatmap Flujo Mensual</h3>
        <div class="heatmap" id="heatmap"></div>
      </div>
      <div class="card card-mb">
        <h3>Acumulado del Mes Actual vs Anterior</h3>
        <div id="acumuladoMesWrap"></div>
      </div>
    </div>

    <!-- ── GASTOS ── -->
    <div class="page" id="page-gastos">
      <div class="kpi-grid" id="kpiGastos"></div>

      <div class="card card-mb">
        <h3>Evolución Mensual</h3>
        <canvas id="chartGasMensual"></canvas>
      </div>

      <div class="card card-mb">
        <h3>Comparativa Mes a Mes</h3>
        <div class="mom-strip" id="gasMomStrip"></div>
      </div>

      <div class="card card-mb">
        <h3>Por Categoría — tocá para ver el detalle</h3>
        <div class="search-wrap">
          <input class="search-input" id="gasCatSearch" type="text" placeholder="Buscar categoría…" />
        </div>
        <div class="acc" id="gasAccordion"></div>
      </div>

      <div class="grid-2">
        <div class="card">
          <h3>Suscripciones</h3>
          <div class="receipt-list" id="gasSubsList"></div>
        </div>
        <div class="card">
          <h3>Top 10 Gastos</h3>
          <div class="receipt-list" id="gasTopList"></div>
        </div>
      </div>
      <div class="card card-mb" style="margin-top:16px">
        <h3>Alertas de suscripciones — precio vs inflación</h3>
        <div id="gasSubAlerts"></div>
      </div>
      <div class="card card-mb" style="margin-top:16px">
        <h3>Gastos Recurrentes Detectados</h3>
        <div id="gasRecurrentesList"></div>
      </div>
    </div>

    <!-- ── INGRESOS ── -->
    <div class="page" id="page-ingresos">
      <div class="kpi-grid" id="kpiIngresos"></div>
      <div class="card card-mb">
        <h3>Evolución de Ingresos</h3>
        <canvas id="chartIngMensual"></canvas>
      </div>
      <div class="grid-2">
        <div class="card">
          <h3>Por Categoría</h3>
          <div class="bar-rows" id="ingBarras"></div>
        </div>
        <div class="card">
          <h3>Detalle por Categoría</h3>
          <div class="tbl-scroll"><table class="tbl" id="tblIngDetalle"></table></div>
        </div>
      </div>
    </div>

    <!-- ── FLUJO ── -->
    <div class="page" id="page-flujo">
      <div class="kpi-grid" id="kpiFlujo"></div>
      <div class="card card-mb">
        <h3>Flujo Neto Mensual</h3>
        <canvas id="chartFlujo"></canvas>
      </div>
      <div class="card">
        <h3>Tabla Completa</h3>
        <div class="tbl-scroll"><table class="tbl" id="tblFlujo"></table></div>
      </div>
    </div>

    <!-- ── PROYECCIÓN ── -->
    <div class="page" id="page-proyeccion">
      <div class="kpi-grid" id="kpiProyeccion"></div>
      <div class="bud-toolbar"><label class="cuenta-field-label" for="projInfl">Inflación mensual esperada %</label><input class="cuenta-input" id="projInfl" type="number" min="0" step="0.1" style="width:90px" /><span class="bud-note" id="projInflNote" style="margin:0"></span></div>
      <div class="card card-mb">
        <h3>Histórico + Proyección 6 meses (escenario base)</h3>
        <canvas id="chartProyeccion"></canvas>
      </div>
      <div class="card card-mb">
        <h3>Neto acumulado proyectado: 3 escenarios</h3>
        <canvas id="chartAcumuladoProy"></canvas>
      </div>
      <div class="card">
        <h3>Detalle Mensual</h3>
        <div class="tbl-scroll" id="proyeccionTabla"></div>
      </div>
    </div>

    <!-- ── AHORROS ── -->
    <div class="page" id="page-ahorros">
      <div class="sec-title">⚡ Oportunidades de ahorro — calculadas sobre tus datos</div>
      <details class="cfg-box">
        <summary>⚙ Reglas de detección (categorías, objetivo de ahorro, cuentas de reserva…)</summary>
        <div id="cfgForm"></div>
      </details>
      <div id="savingsGoal"></div>
      <div class="savings-list" id="savingsList"></div>
      <div class="sec-title" style="margin-top:24px">🚨 Alertas</div>
      <div id="alertsList"></div>
      <div class="sec-title">✅ Lo que hacés bien</div>
      <div id="positivesList"></div>
      <div class="sec-title">🎯 Plan de acción</div>
      <div id="planList"></div>
    </div>

    <!-- ── PRESUPUESTO ── -->
    <div class="page" id="page-presupuesto">
      <div class="kpi-grid" id="kpiPresupuesto"></div>
      <div class="card card-mb">
        <h3>Topes por categoría</h3>
        <div class="bud-toolbar">
          <label class="cuenta-field-label" for="budMonth">Mes</label>
          <select class="filter-select narrow" id="budMonth"></select>
          <label class="cuenta-field-label"><input type="checkbox" id="budAuto" /> Ajustar topes por inflación</label>
          <button class="header-btn" id="budSuggestBtn">✨ Sugerir topes (prom. 3 meses +5%)</button>
          <button class="header-btn" id="budClearBtn">✕ Borrar topes</button>
        </div>
        <div class="bud-note" id="budAutoNote"></div>
        <div class="tbl-scroll" id="presupuestoTabla"></div>
      </div>
      <div class="grid-2">
        <div class="card"><h3>Gastos fijos vs variables</h3><canvas id="chartFijos"></canvas></div>
        <div class="card"><h3>Gastos fijos detectados</h3><div id="fijosList"></div></div>
      </div>
      <div class="card card-mb"><h3>Colchón financiero</h3><div id="runwayBox"></div></div>
    </div>

    <!-- ── METAS ── -->
    <div class="page" id="page-metas">
      <div class="sec-title">🎯 Metas de ahorro</div>
      <form class="card card-mb meta-form" id="metaForm">
        <h3>Nueva meta</h3>
        <div class="cfg-grid">
          <label class="cfg-field"><span class="cfg-label">Nombre</span><input class="cuenta-input cfg-input" id="metaNombre" type="text" placeholder="Viajesito" required /></label>
          <label class="cfg-field"><span class="cfg-label">Monto objetivo</span><input class="cuenta-input cfg-input" id="metaObjetivo" type="number" min="1" step="any" placeholder="3000" required /></label>
          <label class="cfg-field"><span class="cfg-label">Moneda</span><select class="filter-select cfg-input" id="metaMoneda"><option value="ARS">Pesos (ARS)</option><option value="USD">Dólares (USD)</option></select></label>
          <label class="cfg-field"><span class="cfg-label">Fecha límite (opcional)</span><input class="cuenta-input cfg-input" id="metaFecha" type="date" /></label>
          <label class="cfg-field"><span class="cfg-label">Cuenta donde ahorrás (opcional)</span><select class="filter-select cfg-input" id="metaCuenta"></select></label>
          <label class="cfg-field"><span class="cfg-label">Ya ahorrado, si no elegís cuenta</span><input class="cuenta-input cfg-input" id="metaActual" type="number" min="0" step="any" placeholder="0" /></label>
        </div>
        <div class="bud-toolbar"><button class="header-btn" type="submit">＋ Agregar meta</button><span class="bud-note" style="margin:0">Si elegís una cuenta con saldo cargado en Cuentas, el avance se calcula solo con sus movimientos.</span></div>
      </form>
      <div id="metasList" class="metas-list"></div>
    </div>

    <!-- ── ANALISIS ── -->
    <div class="page" id="page-analisis">
      <div class="kpi-grid" id="kpiAnalisis"></div>
      <div class="grid-2">
        <div class="card"><h3>Tasa de ahorro: contable vs real</h3><canvas id="chartAhorroReal"></canvas></div>
        <div class="card">
          <h3>Gasto nominal vs real (ajustado por inflación)</h3>
          <div class="bud-toolbar"><label class="cuenta-field-label" for="inflInput">Valor manual si falta dato %</label><input class="cuenta-input" id="inflInput" type="number" min="0" step="0.1" placeholder="0" style="width:90px" /><span class="bud-note" id="inflStatus" style="margin:0"></span></div>
          <canvas id="chartReal"></canvas>
        </div>
      </div>
      <div class="card card-mb"><h3>Año contra año — gasto por mes</h3><canvas id="chartYoY"></canvas></div>
      <div class="card card-mb"><h3>Pareto de categorías</h3><div class="bud-note" id="paretoNote"></div><canvas id="chartPareto"></canvas></div>
      <div class="card card-mb"><h3>Gasto por cuenta mes a mes</h3><canvas id="chartCuentaMes"></canvas></div>
      <div class="grid-2">
        <div class="card"><h3>Anomalías detectadas</h3><div id="anomaliasBox"></div></div>
        <div class="card"><h3>Transferencias entre cuentas</h3><div id="flujoCuentas"></div></div>
      </div>
    </div>

    <!-- ── PATRIMONIO ── -->
    <div class="page" id="page-patrimonio">
      <div class="sec-title">🏦 Evolución del patrimonio</div>
      <div class="kpi-grid" id="kpiPatrimonio"></div>
      <div class="card card-mb"><h3>Saldo por cuenta a fin de mes (dólares valorizados a la cotización de cada mes)</h3><canvas id="chartPatrimonio"></canvas></div>
      <div class="sec-title" style="margin-top:24px">💵 Dólares</div>
      <div class="bud-toolbar"><label class="cuenta-field-label" for="fxSelect">Cotización</label><select class="filter-select narrow" id="fxSelect"></select><span class="bud-note" id="fxStatus" style="margin:0"></span></div>
      <div class="kpi-grid" id="kpiUsd"></div>
      <div class="grid-2">
        <div class="card"><h3>USD acumulados</h3><canvas id="chartUsdAcum"></canvas></div>
        <div class="card"><h3>Compras de USD: precio pagado vs mercado</h3><canvas id="chartUsdCompras"></canvas></div>
      </div>
      <div class="card card-mb"><h3>Últimas compras de dólares</h3><div id="usdComprasList"></div></div>
      <div class="card card-mb"><h3>Auditoría de conversiones USD ↔ pesos</h3><div class="bud-note" id="usdAuditNote"></div><label class="cuenta-field-label" style="display:flex;gap:8px;align-items:center;margin-bottom:10px"><input type="checkbox" id="fxRevalue" /> Valuar en pesos las operaciones en dólares al dólar de mercado del día (corrige montos cargados con un tipo de cambio viejo; afecta todos los gráficos)</label><div class="tbl-scroll" id="usdAudit" style="max-height:420px;overflow-y:auto"></div></div>
    </div>

    <!-- ── HABITOS ── -->
    <div class="page" id="page-habitos">
      <div class="kpi-grid" id="kpiHabitos"></div>
      <div class="grid-2">
        <div class="card"><h3>Gasto por día de la semana</h3><canvas id="chartDow"></canvas></div>
        <div class="card"><h3>Gasto por día del mes</h3><canvas id="chartDom"></canvas></div>
      </div>
      <div class="card card-mb"><h3>Categorías principales mes a mes</h3><canvas id="chartCatMes"></canvas></div>
      <div class="card card-mb"><h3>Calendario de gasto diario (últimas 52 semanas)</h3><div class="cal-wrap"><div class="cal-grid" id="calGasto"></div></div></div>
      <div class="card card-mb"><h3>Variación por categoría: último mes vs anterior</h3><canvas id="chartVar"></canvas></div>
      <div class="grid-2">
        <div class="card"><h3>Distribución por tamaño de compra</h3><canvas id="chartTicket"></canvas></div>
        <div class="card"><h3>Dónde más se repite el gasto</h3><div class="receipt-list" id="habTopComercios"></div></div>
      </div>
    </div>

    <!-- ── COMENTARIOS ── -->
    <div class="page" id="page-comentarios">
      <div class="com-toolbar">
        <input class="search-input" id="comSearch" type="text" placeholder="Buscar comentario o categoría…" />
        <select class="filter-select" id="comType">
          <option value="gastos">Gastos</option>
          <option value="ingresos">Ingresos</option>
        </select>
      </div>
      <div id="comCatList"></div>
    </div>

    <!-- ── CUENTAS ── -->
    <div class="page" id="page-cuentas">
      <div id="cuentasPanel"></div>
    </div>
  </div>

  <div id="reportOverlay" class="report-overlay" hidden>
    <div class="report-bar">
      <select class="filter-select" id="reportType"><option value="mensual">Mensual</option><option value="anual">Anual</option></select>
      <select class="filter-select" id="reportMonth"></select>
      <button class="header-btn" id="reportPrint">🖨 Imprimir / guardar PDF</button>
      <button class="header-btn" id="reportClose">✕ Cerrar</button>
    </div>
    <article class="report-page" id="reportBody"></article>
  </div>

  <div id="loadingOverlay">
    <div class="spinner"></div>
    <div class="loading-text">Procesando tu archivo…</div>
  </div>

  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
  <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
  <script>
    import '../scripts/app.js';
  </script>
</Layout>
